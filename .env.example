# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- backend
LOG_LEVEL=INFO
MODEL_DIR=models/fraud_detector
MAX_BATCH_SIZE=1000
SHAP_TOP_K=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------- GenAI layer
# Leave LLM_PROVIDER=none to run without an LLM. The investigation agent then
# produces a deterministic report from the ML evidence instead of failing.
# Supported: none | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=900

# --------------------------------------------------------------- frontend
# Baked in at build time. Leave as /api to use the nginx same-origin proxy.
VITE_API_URL=/api

# ----------------------------------------------------------------- Kaggle
# Only needed by ml/scripts/download_data.py.
KAGGLE_USERNAME=
KAGGLE_KEY=
